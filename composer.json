{
  "name": "rabbitevents/deduplication",
  "description": "Skips messages redelivered to RabbitEvents listeners, using a Laravel cache store shared by the workers",
  "keywords": [
    "laravel",
    "rabbitmq",
    "rabbitevents",
    "deduplication",
    "idempotency"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eugene Kirdzei",
      "email": "masterjus@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/cache": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "psr/log": "^3.0",
    "rabbitevents/listener": "^10.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "RabbitEvents\\Deduplication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RabbitEvents\\Deduplication\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RabbitEvents\\Deduplication\\DeduplicationServiceProvider"
      ]
    }
  }
}
